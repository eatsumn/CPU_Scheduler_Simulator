<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="600.0" maxWidth="850.0" minHeight="600.0" minWidth="850.0" prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lorelei.cpu_scheduler.SceneControllers.SelectionScreenController">
   <children>
      <ImageView fitHeight="342.0" fitWidth="249.0" layoutX="608.0" layoutY="142.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/select_charac.png" />
         </image>
      </ImageView>
      <Button layoutX="673.0" layoutY="484.0" mnemonicParsing="false" onAction="#GoToMenu" prefHeight="79.0" prefWidth="111.0" text="Back To menu" />
      <TableView layoutX="41.0" layoutY="135.0" prefHeight="415.0" prefWidth="567.0">
        <columns>
          <TableColumn fx:id="tableProcessNumber" prefWidth="97.0" text="Process Number" />
          <TableColumn fx:id="tableArrivalTime" prefWidth="94.0" text="Arrival Time" />
            <TableColumn fx:id="timeBurstTime" prefWidth="122.0" text="Burst Time" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <ToolBar layoutX="41.0" layoutY="94.0" prefHeight="40.0" prefWidth="567.0">
         <items>
            <TextField fx:id="inputArrivalTime" promptText="Insert Arrival Time" />
            <TextField fx:id="inputBurstTime" promptText="Insert Burst Time" />
            <TextField fx:id="inputProcessName" promptText="{Custom Process Name}" />
            <Button fx:id="addProcess" mnemonicParsing="false" text="Add Process" />
         </items>
      </ToolBar>
      <ChoiceBox layoutX="654.0" layoutY="54.0" prefHeight="40.0" prefWidth="150.0" />
   </children>
</AnchorPane>
