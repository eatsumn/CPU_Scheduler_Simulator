                     <children>
                        <CheckBox fx:id="secretAlgoCheckBox" mnemonicParsing="false" onAction="#secretAlgoSwitch" style="-fx-background-color: #ccc; -fx-background-radius: 20; -fx-padding: 5; -fx-opacity: 50; -fx-border-color: green; -fx-border-width: 5; -fx-border-radius: 6;" />
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Secret Algorithms" textAlignment="CENTER">
                           <font>
                              <Font size="30.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="10.0" />
                           </HBox.margin>
                        </Text>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <CheckBox fx:id="randomFloatCheckBox" mnemonicParsing="false" onAction="#randomFloatSwitch" style="-fx-background-color: #ccc; -fx-background-radius: 20; -fx-padding: 5; -fx-opacity: 50; -fx-border-color: green; -fx-border-width: 5; -fx-border-radius: 6;" />
